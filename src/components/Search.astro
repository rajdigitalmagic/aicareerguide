---
// This component uses Fuse.js. It will be hydrated on load.
---

<div class="relative" id="search-container">
  <input
    type="text"
    id="search-input"
    placeholder="Search articles..."
    class="w-48 sm:w-64 px-3 py-1.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-secondary)] text-[var(--color-text-primary)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition-colors text-sm"
    aria-label="Search"
  />
  <div id="search-results" class="absolute right-0 mt-2 w-72 max-h-96 overflow-y-auto bg-[var(--color-bg)] border border-[var(--color-border)] rounded-lg shadow-lg hidden"></div>
</div>

<script>
  import Fuse from 'fuse.js';
  
  let fuse = null;
  const input = document.getElementById('search-input');
  const container = document.getElementById('search-container');
  const resultsEl = document.getElementById('search-results');

  async function loadIndex() {
    const res = await fetch('/search-index.json');
    const data = await res.json();
    fuse = new Fuse(data, {
      keys: ['title', 'description', 'category', 'tags'],
      threshold: 0.3,
      includeScore: true,
    });
  }

  function render(results) {
    if (!results.length) {
      resultsEl.innerHTML = '<div class="p-3 text-sm text-[var(--color-text-muted)]">No results</div>';
      resultsEl.classList.remove('hidden');
      return;
    }
    let html = '<ul class="divide-y divide-[var(--color-border)]">';
    results.slice(0, 6).forEach(({ item }) => {
      html += `
        <li>
          <a href="${item.url}" class="block p-3 hover:bg-[var(--color-bg-secondary)] transition-colors">
            <div class="text-sm font-medium text-[var(--color-text-primary)]">${item.title}</div>
            <div class="text-xs text-[var(--color-text-muted)]">${item.category} · ${item.tags?.join(', ') || ''}</div>
          </a>
        </li>
      `;
    });
    html += '</ul>';
    resultsEl.innerHTML = html;
    resultsEl.classList.remove('hidden');
  }

  input.addEventListener('focus', async () => {
    if (!fuse) await loadIndex();
    const query = input.value.trim();
    if (query) {
      const results = fuse.search(query);
      render(results);
    } else {
      resultsEl.classList.add('hidden');
    }
  });

  input.addEventListener('input', async () => {
    if (!fuse) await loadIndex();
    const query = input.value.trim();
    if (!query) {
      resultsEl.classList.add('hidden');
      return;
    }
    const results = fuse.search(query);
    render(results);
  });

  document.addEventListener('click', (e) => {
    if (!container.contains(e.target)) {
      resultsEl.classList.add('hidden');
    }
  });
</script>