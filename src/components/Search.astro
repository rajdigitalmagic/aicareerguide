---
// We'll use Fuse.js client-side. This component is hydrated on load.
---

<div class="relative" id="search-container">
  <input
    type="text"
    id="search-input"
    placeholder="Search articles..."
    class="w-48 sm:w-64 px-3 py-1.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-secondary)] text-[var(--color-text-primary)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition-colors text-sm"
    aria-label="Search"
  />
  <div id="search-results" class="absolute right-0 mt-2 w-72 max-h-96 overflow-y-auto bg-[var(--color-bg)] border border-[var(--color-border)] rounded-lg shadow-lg hidden"></div>
</div>

<script>
  import Fuse from 'fuse.js';
  
  let fuse = null;
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');

  // Fetch search index (generated statically)
  async function loadSearchIndex() {
    const res = await fetch('/search-index.json');
    const data = await res.json();
    fuse = new Fuse(data, {
      keys: ['title', 'description', 'category', 'tags'],
      threshold: 0.3,
      includeScore: true,
    });
  }

  function renderResults(results) {
    if (results.length === 0) {
      resultsContainer.innerHTML = '<div class="p-3 text-sm text-[var(--color-text-muted)]">No results found</div>';
      resultsContainer.classList.remove('hidden');
      return;
    }
    let html = '<ul class="divide-y divide-[var(--color-border)]">';
    results.slice(0, 5).forEach(({ item }) => {
      html += `
        <li>
          <a href="${item.url}" class="block p-3 hover:bg-[var(--color-bg-secondary)] transition-colors">
            <div class="text-sm font-medium text-[var(--color-text-primary)]">${item.title}</div>
            <div class="text-xs text-[var(--color-text-muted)]">${item.category} · ${item.tags?.join(', ') || ''}</div>
          </a>
        </li>
      `;
    });
    html += '</ul>';
    resultsContainer.innerHTML = html;
    resultsContainer.classList.remove('hidden');
  }

  input.addEventListener('focus', () => {
    if (fuse && input.value.length > 0) {
      const results = fuse.search(input.value);
      renderResults(results);
    } else {
      resultsContainer.classList.add('hidden');
    }
  });

  input.addEventListener('input', async () => {
    if (!fuse) await loadSearchIndex();
    const query = input.value.trim();
    if (query.length === 0) {
      resultsContainer.classList.add('hidden');
      return;
    }
    const results = fuse.search(query);
    renderResults(results);
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('#search-container')) {
      resultsContainer.classList.add('hidden');
    }
  });
</script>
