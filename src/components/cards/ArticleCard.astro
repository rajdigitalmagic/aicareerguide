---
// src/components/cards/ArticleCard.astro
export interface Props {
  post: {
    slug: string;
    body?: string;
    data: any;
  };
}

const { post } = Astro.props;
const { slug, data, body } = post;

// Calculate reading time automatically (assuming ~200 words per minute)
const wordCount = body ? body.split(/\s+/).length : 0;
const autoReadingTime = wordCount > 0 ? Math.ceil(wordCount / 200).toString() : "1";
const displayReadingTime = data.readingTime || autoReadingTime;
---

<a href={`/blog/${slug}`} data-category={data.category.toLowerCase()} class="article-card group block border border-[var(--color-border)] rounded-xl p-5 hover:shadow-md transition-shadow bg-[var(--color-bg)]">
  <div class="text-sm font-semibold text-[var(--color-accent)] uppercase tracking-wide">{data.category}</div>
  <h3 class="mt-2 text-lg font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors">{data.title}</h3>
  <p class="mt-1 text-sm text-[var(--color-text-secondary)] line-clamp-2">{data.description}</p>
  
  <div class="mt-3 flex items-center gap-2 text-xs text-[var(--color-text-muted)]">
    <time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
    <span>•</span>
    <span>{displayReadingTime} min read</span>
  </div>
</a>
