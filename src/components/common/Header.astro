---
import ThemeToggle from './ThemeToggle.astro';
import Search from '@/components/Search.astro';
---

<header class="border-b border-[var(--color-border)] bg-[var(--color-bg)] sticky top-0 z-50 backdrop-blur-sm bg-opacity-95">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo -->
      <div class="flex items-center space-x-2">
        <a href="/" class="text-xl font-bold text-[var(--color-text-primary)] hover:text-[var(--color-accent)] transition-colors">
          <span class="sr-only">AI Career Guide</span>
          <span class="hidden sm:inline">AI Career Guide</span>
          <span class="sm:hidden">AI</span>
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-6 text-sm font-medium text-[var(--color-text-secondary)]">
        <a href="/ai" class="hover:text-[var(--color-accent)] transition-colors">AI</a>
        <a href="/careers" class="hover:text-[var(--color-accent)] transition-colors">Careers</a>
        <a href="/projects" class="hover:text-[var(--color-accent)] transition-colors">Projects</a>
        <a href="/tools" class="hover:text-[var(--color-accent)] transition-colors">Tools</a>
        <a href="/resources" class="hover:text-[var(--color-accent)] transition-colors">Resources</a>
        <a href="/blog" class="hover:text-[var(--color-accent)] transition-colors">Blog</a>
      </nav>

      <div class="flex items-center space-x-3">
        <Search />
        <ThemeToggle />
        
        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-[var(--color-bg-secondary)] transition-colors" aria-label="Menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav Container (Hidden by default) -->
  <div id="mobile-nav" class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]">
    <nav class="flex flex-col px-4 pt-2 pb-4 space-y-1 text-base font-medium text-[var(--color-text-secondary)]">
      <a href="/ai" class="block px-3 py-2 rounded-md hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-accent)]">AI</a>
      <a href="/careers" class="block px-3 py-2 rounded-md hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-accent)]">Careers</a>
      <a href="/projects" class="block px-3 py-2 rounded-md hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-accent)]">Projects</a>
      <a href="/tools" class="block px-3 py-2 rounded-md hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-accent)]">Tools</a>
      <a href="/resources" class="block px-3 py-2 rounded-md hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-accent)]">Resources</a>
      <a href="/blog" class="block px-3 py-2 rounded-md hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-accent)]">Blog</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');

  // Toggle menu on click
  btn?.addEventListener('click', () => {
    nav?.classList.toggle('hidden');
  });

  // Automatically hide the mobile menu if the screen resizes to desktop width
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) { // 768px is the 'md' breakpoint in Tailwind
      nav?.classList.add('hidden');
    }
  });
</script>
