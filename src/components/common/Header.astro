---
import ThemeToggle from './ThemeToggle.astro';
import Search from '@/components/Search.astro';
import { Search as SearchIcon, Menu, X } from 'lucide-astro';
const nav = [{label:'AI',href:'/ai'},{label:'Careers',href:'/careers'},{label:'Projects',href:'/projects'},{label:'Tools',href:'/tools'},{label:'Resources',href:'/resources'},{label:'Blog',href:'/blog'}];
---
<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur supports-[backdrop-filter]:bg-[var(--color-bg)]/85">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex h-16 items-center justify-between gap-2">
    <a href="/" class="flex items-center gap-2.5 min-w-0 shrink-0" aria-label="AI Career Guide home"><img src="/logo.webp" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" /><span class="truncate text-lg font-bold">AI Career Guide</span></a>
    <nav aria-label="Primary" class="hidden lg:flex items-center gap-5 text-sm font-medium text-[var(--color-text-secondary)]">{nav.map(item=>{const active=Astro.url.pathname===item.href || Astro.url.pathname.startsWith(`${item.href}/`); return <a href={item.href} aria-current={active?'page':undefined} class:list={[active ? 'text-[var(--color-accent)]' : '', 'hover:text-[var(--color-accent)]']}>{item.label}</a>})}</nav>
    <div class="flex items-center gap-1 sm:gap-2"><div class="hidden sm:block"><Search /></div><a href="/search" class="sm:hidden min-h-11 min-w-11 inline-flex items-center justify-center rounded-lg hover:bg-[var(--color-bg-secondary)]" aria-label="Search"><SearchIcon class="h-5 w-5" /></a><ThemeToggle /><button id="mobile-menu-btn" class="lg:hidden min-h-11 min-w-11 rounded-lg hover:bg-[var(--color-bg-secondary)]" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu"><Menu id="mobile-menu-open" class="mx-auto h-5 w-5" /><X id="mobile-menu-close" class="mx-auto hidden h-5 w-5" /></button></div>
  </div></div>
  <div id="mobile-nav" class="hidden lg:hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]"><nav aria-label="Mobile" class="max-w-7xl mx-auto px-4 py-3">{nav.map(item=>{const active=Astro.url.pathname===item.href || Astro.url.pathname.startsWith(`${item.href}/`); return <a href={item.href} aria-current={active?'page':undefined} class:list={[active ? 'bg-[var(--color-bg-secondary)] text-[var(--color-accent)]' : '', 'block min-h-11 rounded-lg px-3 py-2.5 font-medium hover:bg-[var(--color-bg-secondary)]']}>{item.label}</a>})}<a href="/search" class="mt-1 flex min-h-11 items-center rounded-lg px-3 py-2.5 font-medium hover:bg-[var(--color-bg-secondary)]">Search</a></nav></div>
</header>
<script>
  const initMobileMenu = () => {
    const btn=document.getElementById('mobile-menu-btn'); const nav=document.getElementById('mobile-nav');
    const openIcon=document.getElementById('mobile-menu-open'); const closeIcon=document.getElementById('mobile-menu-close');
    if(!btn||!nav||btn.dataset.ready==='true') return;
    btn.dataset.ready='true';
    const setOpen=(open:boolean)=>{nav.classList.toggle('hidden',!open);btn.setAttribute('aria-expanded',String(open));btn.setAttribute('aria-label',open?'Close menu':'Open menu');openIcon?.classList.toggle('hidden',open);closeIcon?.classList.toggle('hidden',!open);document.body.style.overflow=open?'hidden':'';};
    btn.addEventListener('click',()=>setOpen(btn.getAttribute('aria-expanded')!=='true'));
    nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>setOpen(false)));
  };
  document.addEventListener('astro:page-load',initMobileMenu);
</script>
