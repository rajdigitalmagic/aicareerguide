<div class="border border-[var(--color-border)] rounded-2xl p-6 bg-[var(--color-bg-secondary)] text-center">
  <h3 class="text-xl font-bold text-[var(--color-text-primary)]">Get Smarter About AI & Your Career</h3>
  <p class="mt-1 text-[var(--color-text-secondary)]">Weekly practical AI & career insights.</p>
  <form class="mt-4 max-w-md mx-auto flex flex-col sm:flex-row gap-3" action="#" method="POST">
    <input type="email" placeholder="your@email.com" required class="flex-1 px-4 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text-primary)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition-colors" />
    <button type="submit" class="px-6 py-2 bg-[var(--color-accent)] text-white rounded-lg font-semibold hover:bg-[var(--color-accent-hover)] transition-colors">Subscribe</button>
