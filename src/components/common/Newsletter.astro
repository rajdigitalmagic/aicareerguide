<div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)] p-7 text-center">
  <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent)]">Newsletter</p>
  <h2 class="mt-2 text-2xl font-bold">Get smarter about AI & your career.</h2>
  <p class="mt-2 text-[var(--color-text-secondary)]">Weekly practical insights. No content farm, no unnecessary noise.</p>
  <form id="newsletter-form" class="mt-6 mx-auto flex max-w-xl flex-col gap-3 sm:flex-row"><label class="sr-only" for="newsletter-email">Email address</label><input id="newsletter-email" name="email" type="email" autocomplete="email" required placeholder="your@email.com" class="min-h-11 flex-1 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-4 text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" /><button class="min-h-11 rounded-lg bg-[var(--color-accent)] px-6 font-semibold text-white hover:bg-[var(--color-accent-hover)]" type="submit">Subscribe</button></form>
  <p id="newsletter-status" class="mt-3 text-xs text-[var(--color-text-muted)]">Newsletter provider can be connected later. Your email is not submitted yet.</p>
</div>
<script>
  document.addEventListener('astro:page-load',()=>{const form=document.getElementById('newsletter-form') as HTMLFormElement|null;const status=document.getElementById('newsletter-status');form?.addEventListener('submit',e=>{e.preventDefault();if(status)status.textContent='Newsletter signup is coming soon. The form is ready for a provider integration.';});});
</script>
