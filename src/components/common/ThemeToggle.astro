---
// src/components/common/ThemeToggle.astro
import { Sun, Moon } from 'lucide-astro';
---

<button 
  id="theme-toggle" 
  class="p-2 rounded-lg text-[var(--color-text-secondary)] hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-accent)] transition-colors" 
  aria-label="Toggle theme"
>
  <!-- The Moon shows in Light Mode -->
  <Moon id="theme-icon-dark" class="w-5 h-5 block dark:hidden" />
  <!-- The Sun shows in Dark Mode -->
  <Sun id="theme-icon-light" class="w-5 h-5 hidden dark:block" />
</button>

<script>
  const toggle = document.getElementById('theme-toggle');
  
  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.classList.contains('dark');
    
    // Determine the new theme
    const newTheme = isDark ? 'light' : 'dark';
    
    // Apply the class to the <html> tag so Tailwind registers it
    html.classList.toggle('dark', newTheme === 'dark');
    
    // Save the user's preference to localStorage so it persists on page refresh
    localStorage.setItem('theme', newTheme);
  });
</script>
