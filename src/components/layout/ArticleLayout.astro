---
// src/components/layout/ArticleLayout.astro
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import AuthorBox from '@/components/AuthorBox.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import Newsletter from '@/components/common/Newsletter.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import { Image } from 'astro:assets'; // <-- Imported Astro's native Image component

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  category: string;
  tags?: string[];
  image?: string;
  readingTime?: string;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts?: any[];
}

const {
  title,
  description,
  pubDate,
  author,
  category,
  tags = [],
  image,
  readingTime,
  headings = [],
  relatedPosts = []
} = Astro.props;

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Blog', url: '/blog' },
  { label: category, url: `/blog?category=${encodeURIComponent(category.toLowerCase())}` },
  { label: title, url: Astro.url.pathname }
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  canonical={Astro.url.pathname}
  article={true}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Breadcrumb Trail -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Article Header Metadata -->
    <header class="mt-4">
      <div class="inline-block text-xs md:text-sm font-semibold text-[var(--color-accent)] uppercase tracking-wider bg-[var(--color-bg-secondary)] px-3 py-1 rounded-md border border-[var(--color-border)]">
        {category}
      </div>
      
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text-primary)] leading-tight tracking-tight mt-4">
        {title}
      </h1>
      
      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] mt-4 leading-relaxed">
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--color-text-muted)] mt-6 border-b border-[var(--color-border)] pb-6">
        <span class="font-medium text-[var(--color-text-primary)]">{author}</span>
        <span>•</span>
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {readingTime && (
          <>
            <span>•</span>
            <span>{readingTime} min read</span>
          </>
        )}
      </div>

      <div class="mt-4 flex items-center justify-between">
        <ShareButtons url={Astro.url.href} title={title} />
      </div>
    </header>

    <!-- Optimized Hero Image -->
    {image && (
      <figure class="mt-8 mb-10 overflow-hidden rounded-2xl border border-[var(--color-border)] shadow-sm bg-[var(--color-bg-secondary)]">
        <Image
          src={image}
          alt={title || 'Article hero image'}
          width={1200}
          height={630}
          class="w-full h-auto object-cover max-h-[500px]"
          loading="eager"
          decoding="async"
        />
      </figure>
    )}

    <!-- Mobile Collapsible Table of Contents -->
    {headings.length > 0 && (
      <div class="lg:hidden mt-8 border border-[var(--color-border)] rounded-xl bg-[var(--color-bg-secondary)] p-4">
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-[var(--color-text-primary)] list-none">
            <span>Table of Contents</span>
            <span class="transition group-open:rotate-180">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-[var(--color-border)]">
            <TableOfContents headings={headings} />
          </div>
        </details>
      </div>
    )}

    <!-- Main Grid: Sticky Sidebar TOC + Markdown Content -->
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-4 gap-12">
      <!-- Desktop Sidebar TOC -->
      {headings.length > 0 && (
        <aside class="hidden lg:block lg:col-span-1">
          <div class="sticky top-24 self-start border-l-2 border-[var(--color-border)] pl-4">
            <TableOfContents headings={headings} />
          </div>
        </aside>
      )}

      <!-- Markdown / MDX Content Slot -->
      <div class:list={[
        "prose prose-lg max-w-none text-[var(--color-text-secondary)]",
        headings.length > 0 ? "lg:col-span-3" : "lg:col-span-4",
        "prose-headings:text-[var(--color-text-primary)] prose-headings:font-bold",
        "prose-p:text-[var(--color-text-secondary)] prose-p:leading-relaxed",
        "prose-a:text-[var(--color-accent)] prose-a:font-medium prose-a:no-underline hover:prose-a:underline",
        "prose-strong:text-[var(--color-text-primary)]",
        "prose-code:before:hidden prose-code:after:hidden",
        "prose-blockquote:text-[var(--color-text-muted)] prose-blockquote:border-l-4 prose-blockquote:border-l-[var(--color-accent)] prose-blockquote:bg-[var(--color-bg-secondary)] prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg",
        "prose-ul:text-[var(--color-text-secondary)] prose-ol:text-[var(--color-text-secondary)] marker:text-[var(--color-text-muted)]",
        "[&_img]:rounded-xl [&_img]:border [&_img]:border-[var(--color-border)]"
      ]}>
        <slot />
      </div>

    <!-- Tags Display -->
    {tags && tags.length > 0 && (
      <div class="mt-12 pt-6 border-t border-[var(--color-border)] flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mr-2">Tags:</span>
        {tags.map(tag => (
          <span class="px-3 py-1 text-xs rounded-full bg-[var(--color-bg-secondary)] text-[var(--color-text-secondary)] border border-[var(--color-border)]">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Author, Related Articles, and Newsletter -->
    <AuthorBox author={author} />
    {relatedPosts.length > 0 && <RelatedPosts posts={relatedPosts} />}
    
    <div class="mt-14">
      <Newsletter />
    </div>
  </article>

  <script>
    function setupCodeBlocks() {
      // Find all code blocks that haven't been processed yet
      const codeBlocks = document.querySelectorAll('.prose pre:not(.code-processed)');
      
      codeBlocks.forEach((pre) => {
        // Mark as processed to prevent duplicate wrappers during view transitions
        pre.classList.add('code-processed');
        
        // 1. Create a positioning wrapper
        const wrapper = document.createElement('div');
        wrapper.className = 'relative flex flex-col mt-8 mb-8 shadow-sm rounded-xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-bg-secondary)]';
        
        // Wrap the <pre> element
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);
        
        // Strip existing margins/borders from the <pre> so the wrapper controls it
        pre.classList.add('!mt-0', '!mb-0', '!border-0', '!rounded-none');
        
        // 2. Determine the language
        // Astro's Shiki automatically injects the data-language attribute
        const language = pre.getAttribute('data-language') || 'Code';
        
        // 3. Create the Header Bar
        const header = document.createElement('div');
        header.className = 'flex items-center justify-between px-4 py-2.5 bg-[var(--color-bg-secondary)] text-xs font-mono text-[var(--color-text-secondary)] border-b border-[var(--color-border)]';
        
        // Language Indicator
        const langSpan = document.createElement('span');
        langSpan.textContent = language.toUpperCase();
        langSpan.className = 'font-semibold tracking-wider';
        
        // Copy Button
        const copyBtn = document.createElement('button');
        copyBtn.className = 'flex items-center gap-1.5 hover:text-[var(--color-text-primary)] transition-colors focus:outline-none';
        copyBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
          <span>Copy</span>
        `;
        
        // Assemble the header
        header.appendChild(langSpan);
        header.appendChild(copyBtn);
        
        // Insert the header at the top of the wrapper
        wrapper.insertBefore(header, pre);
        
        // 4. Implement Copy Functionality
        copyBtn.addEventListener('click', async () => {
          // Get the raw text from the <code> tag inside the <pre>
          const codeText = pre.querySelector('code')?.innerText || (pre as HTMLElement).innerText;
          
          try {
            await navigator.clipboard.writeText(codeText);
            
            // Visual success feedback
            copyBtn.innerHTML = `
              <svg class="w-4 h-4 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-[var(--color-accent)] font-medium">Copied!</span>
            `;
            
            // Reset button after 2 seconds
            setTimeout(() => {
              copyBtn.innerHTML = `
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                <span>Copy</span>
              `;
            }, 2000);
          } catch (err) {
            console.error('Failed to copy code snippet: ', err);
            const span = copyBtn.querySelector('span');
            if (span) span.textContent = 'Error';
          }
        });
      });
    }

    // Run on standard initial page load
    document.addEventListener('DOMContentLoaded', setupCodeBlocks);
    
    // Run on Astro View Transitions navigation (if enabled in the future)
    document.addEventListener('astro:page-load', setupCodeBlocks);
  </script>
</BaseLayout>
