---
import BaseLayout from './BaseLayout.astro';import TableOfContents from '@/components/TableOfContents.astro';import RelatedPosts from '@/components/RelatedPosts.astro';import AuthorBox from '@/components/AuthorBox.astro';import ShareButtons from '@/components/ShareButtons.astro';import Newsletter from '@/components/common/Newsletter.astro';import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
export interface Props { title:string;description:string;pubDate:Date;updatedDate?:Date;lastReviewed?:Date;sources?:string[];author:string;category:string;tags?:string[];topics?:string[];image?:string;readingTime?:string;headings:{depth:number;slug:string;text:string}[];relatedPosts?:any[];canonical?:string }
const {title,description,pubDate,updatedDate,lastReviewed,sources=[],author,category,tags=[],topics=[],image,readingTime,headings=[],relatedPosts=[],canonical}=Astro.props;
const breadcrumbItems=[{label:'Home',url:'/'},{label:'Blog',url:'/blog'},{label:category,url:`/blog?category=${encodeURIComponent(category)}`},{label:title,url:Astro.url.pathname}];
---
<BaseLayout title={title} description={description} image={image} canonical={canonical||Astro.url.pathname} article pubDate={pubDate} author={author} updatedDate={updatedDate} breadcrumbs={breadcrumbItems}>
<article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14"><Breadcrumbs items={breadcrumbItems}/>
<header class="max-w-article"><span class="pill">{category}</span><h1 class="mt-5 text-4xl sm:text-5xl font-bold tracking-tight">{title}</h1><p class="mt-5 text-xl leading-8 text-[var(--color-text-secondary)]">{description}</p><div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-[var(--color-text-muted)]"><span class="font-semibold text-[var(--color-text-primary)]">{author}</span><span>•</span><time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time><span>•</span><span>{readingTime} min read</span></div>{(updatedDate||lastReviewed)&&<div class="mt-3 flex flex-wrap gap-4 text-xs text-[var(--color-text-muted)]">{updatedDate&&<span>Updated {updatedDate.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span>}{lastReviewed&&<span>Reviewed {lastReviewed.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span>}</div>}<div class="mt-5"><ShareButtons url={Astro.url.href} title={title}/></div></header>
{image&&<figure class="mt-10 overflow-hidden rounded-2xl border border-[var(--color-border)]"><img src={image} alt={title} width="1200" height="630" loading="eager" decoding="async" class="w-full object-cover"/></figure>}
{headings.length>0&&<div class="mt-8 lg:hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)] p-4"><details><summary class="cursor-pointer font-semibold">Table of Contents</summary><div class="mt-4"><TableOfContents headings={headings}/></div></details></div>}
<div class="mt-10 grid grid-cols-1 lg:grid-cols-[190px_minmax(0,780px)] gap-10"><aside class="hidden lg:block"><div class="sticky top-24 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)] p-4"><TableOfContents headings={headings}/></div></aside><div class="prose"><slot/></div></div>
<footer class="mt-16 max-w-article"><div class="border-t border-[var(--color-border)] pt-8">{topics.length>0&&<div class="mb-5 flex flex-wrap gap-2"><span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Topics</span>{topics.map(topic=><span class="tag">{topic}</span>)}</div>}{tags.length>0&&<div class="mb-8 flex flex-wrap gap-2"><span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Tags</span>{tags.map(tag=><span class="tag">#{tag}</span>)}</div>}{sources.length>0&&<div class="mb-8"><h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Sources & References</h2><ul class="mt-3 space-y-2 text-sm">{sources.map(source=><li><a href={source} target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline break-all">{source}</a></li>)}</ul></div>}</div><AuthorBox author={author}/>{relatedPosts.length>0&&<RelatedPosts posts={relatedPosts}/>}<div class="mt-14"><Newsletter/></div></footer></article>
</BaseLayout>
