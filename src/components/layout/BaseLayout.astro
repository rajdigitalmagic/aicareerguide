---
// src/components/layout/BaseLayout.astro
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import SEO from '@/components/seo/SEO.astro';
import { ViewTransitions } from 'astro:transitions';

export interface Props {
  title?: string;
  description?: string;
  image?: any;
  canonical?: string;
  article?: boolean;
  pubDate?: Date;
  author?: string;
}

const { title, description, image, canonical, article = false, pubDate, author } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Theme script placed first to prevent flash, with OS sync added -->
  <script is:inline>
    function applyTheme() {
      const stored = localStorage.getItem('theme');
      const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const theme = stored || system;
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
    applyTheme();
    document.addEventListener('astro:after-swap', applyTheme);
    
    // Sync with OS changes dynamically if the user hasn't forced a preference
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!localStorage.getItem('theme')) applyTheme();
    });
  </script>

  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <SEO {title} {description} {image} {canonical} {article} {pubDate} {author} />
  
  <ViewTransitions />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
     href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;600&display=swap"
     rel="stylesheet"
     media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </noscript>
  <style is:global>
    @import '/src/styles/global.css';
  </style>
</head>

<body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text-primary)] transition-colors duration-200">
  
  <!-- Skip to Content Link (WCAG Requirement) -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] px-4 py-2 bg-[var(--color-accent)] text-white rounded-md font-bold shadow-lg">
    Skip to content
  </a>

  <Header />
  
  <!-- Added ID for the skip link -->
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  
  <Footer />
  <!-- Global Code Block UI & Copy Button Script -->
  <script>
    function setupCodeBlocks() {
      const codeBlocks = document.querySelectorAll('.prose pre:not(.code-processed)');
      
      codeBlocks.forEach((pre) => {
        pre.classList.add('code-processed');
        
        const wrapper = document.createElement('div');
        wrapper.className = 'relative flex flex-col mt-8 mb-8 shadow-sm rounded-xl overflow-hidden border border-[var(--color-border)]';
        
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);
        
        pre.classList.add('!mt-0', '!mb-0', '!border-0', '!rounded-none');
        
        const language = pre.getAttribute('data-language') || 'Code';
        
        const header = document.createElement('div');
        header.className = 'flex items-center justify-between px-4 py-2.5 bg-[var(--color-bg-secondary)] text-xs font-mono text-[var(--color-text-secondary)] border-b border-[var(--color-border)]';
        
        const langSpan = document.createElement('span');
        langSpan.textContent = language.toUpperCase();
        langSpan.className = 'font-semibold tracking-wider';
        
        const copyBtn = document.createElement('button');
        copyBtn.className = 'flex items-center gap-1.5 hover:text-[var(--color-text-primary)] transition-colors focus:outline-none';
        copyBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
          <span>Copy</span>
        `;
        
        header.appendChild(langSpan);
        header.appendChild(copyBtn);
        wrapper.insertBefore(header, pre);
        
        copyBtn.addEventListener('click', async () => {
          // FIX: Use textContent instead of innerText to perfectly preserve line breaks
          const codeText = pre.querySelector('code')?.textContent || (pre as HTMLElement).textContent || '';
          try {
            await navigator.clipboard.writeText(codeText);
            copyBtn.innerHTML = `
              <svg class="w-4 h-4 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-[var(--color-accent)] font-medium">Copied!</span>
            `;
            setTimeout(() => {
              copyBtn.innerHTML = `
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                <span>Copy</span>
              `;
            }, 2000);
          } catch (err) {
            console.error('Failed to copy code snippet: ', err);
            const span = copyBtn.querySelector('span');
            if (span) span.textContent = 'Error';
          }
        });
      });
    }

    // FIX: Only use astro:page-load to prevent running twice on initial visit
    document.addEventListener('astro:page-load', setupCodeBlocks);
  </script>
</body>
</html>
