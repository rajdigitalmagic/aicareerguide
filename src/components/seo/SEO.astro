---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  article?: boolean;
}
const { title, description, image, canonical, article = false } = Astro.props;
const siteTitle = 'AI Career Guide';
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const desc = description || 'Practical AI, technology, and career guidance for people building their future in tech.';
const img = image || '/images/og-default.jpg';
const url = canonical || Astro.url.href;
---

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:image" content={new URL(img, Astro.site).href} />
<meta property="og:url" content={url} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={new URL(img, Astro.site).href} />
<link rel="canonical" href={url} />
{article && <meta property="og:type" content="article" />}
{title && <title>{fullTitle}</title>}
{!title && <title>{siteTitle}</title>}
{desc && <meta name="description" content={desc} />}

<!-- JSON-LD for articles if needed -->
{article && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description: desc,
    image: new URL(img, Astro.site).href,
    datePublished: new Date().toISOString(),
    author: {
      "@type": "Organization",
      name: "AI Career Guide"
    }
  })} />
)}
