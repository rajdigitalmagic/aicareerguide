---
import ArticleLayout from '@/components/layout/ArticleLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('blog',({data})=>!data.draft);return posts.map(post=>({params:{slug:post.slug},props:{post}}));}
const {post}=Astro.props;const {Content,headings}=await post.render();
const all=await getCollection('blog',({data})=>!data.draft);
const score=(candidate:any)=>{const tags=new Set([...(post.data.tags||[]),...(post.data.topics||[])]);const candidateTags=[...(candidate.data.tags||[]),...(candidate.data.topics||[])];return (candidate.data.category===post.data.category?3:0)+candidateTags.filter((t:string)=>tags.has(t)).length;};
const related=all.filter(p=>p.slug!==post.slug).sort((a,b)=>score(b)-score(a)||b.data.pubDate.getTime()-a.data.pubDate.getTime()).slice(0,3);
const words=post.body?.split(/\s+/).filter(Boolean).length||0;const readingTime=post.data.readingTime||Math.max(1,Math.ceil(words/200)).toString();
---
<ArticleLayout title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} lastReviewed={post.data.lastReviewed} sources={post.data.sources} author={post.data.author} category={post.data.category} tags={post.data.tags} topics={post.data.topics} image={post.data.image} readingTime={readingTime} headings={headings} relatedPosts={related} canonical={post.data.canonical}><Content/></ArticleLayout>
