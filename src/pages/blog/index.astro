---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import { getCollection } from 'astro:content';
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = [...allPosts].sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime());
const featured = sorted.find(post => post.data.featured) ?? sorted[0];
const latest = featured ? sorted.filter(post => post.slug !== featured.slug) : sorted;
const categories = ['All', 'AI', 'Career', 'Projects', 'Technology'];
---
<BaseLayout title="Blog | AI Career Guide" description="Practical articles on AI, technology, projects, and careers.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent)]">Knowledge</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Blog</h1>
    <p class="mt-3 max-w-2xl text-lg text-[var(--color-text-secondary)]">Practical knowledge for learning AI, building software, and navigating technical careers.</p>
    <div class="mt-7"><label for="article-search" class="sr-only">Search articles</label><input id="article-search" type="search" placeholder="Search articles..." class="w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-[var(--color-text-primary)] focus:ring-2 focus:ring-[var(--color-accent)] focus:outline-none" /></div>
    <div class="mt-4 flex flex-wrap gap-2">{categories.map(cat => <button class="blog-filter rounded-full border border-[var(--color-border)] px-4 py-2 text-sm" data-filter={cat}>{cat}</button>)}</div>
    {featured && <section class="mt-10"><p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent)]">Featured</p><div class="mt-4 max-w-3xl"><ArticleCard post={featured} /></div></section>}
    <section class="mt-12"><div class="flex items-end justify-between"><h2 class="text-2xl font-bold">Latest</h2><span id="article-count" class="text-sm text-[var(--color-text-muted)]">{latest.length} articles</span></div><div id="articles-grid" class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{latest.map(post => <div class="blog-card" data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.category} ${(post.data.tags||[]).join(' ')}`}><ArticleCard post={post} /></div>)}</div><div id="blog-empty" class="hidden mt-8 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)] p-10 text-center text-[var(--color-text-muted)]">No articles match your search.</div></section>
  </div>
  <script>
    document.addEventListener('astro:page-load',()=>{const buttons=document.querySelectorAll<HTMLButtonElement>('.blog-filter');const cards=document.querySelectorAll<HTMLElement>('.blog-card');const input=document.getElementById('article-search') as HTMLInputElement|null;const empty=document.getElementById('blog-empty');const count=document.getElementById('article-count');const requested=new URLSearchParams(location.search).get('category');const available=['All','AI','Career','Projects','Technology'];const requestedLabel=requested?requested.charAt(0).toUpperCase()+requested.slice(1):'All';let filter=available.includes(requestedLabel)?requestedLabel:'All';const update=()=>{const q=(input?.value||'').trim().toLowerCase();let visible=0;cards.forEach(card=>{const okCat=filter==='All'||card.dataset.category===filter;const okText=!q||(card.dataset.search||'').toLowerCase().includes(q);const show=okCat&&okText;card.classList.toggle('hidden',!show);if(show)visible++;});if(count)count.textContent=`${visible} article${visible===1?'':'s'}`;empty?.classList.toggle('hidden',visible>0);buttons.forEach(b=>b.classList.toggle('active-filter',b.dataset.filter===filter));};buttons.forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.filter||'All';update();}));input?.addEventListener('input',update);update();});
  </script>
</BaseLayout>
