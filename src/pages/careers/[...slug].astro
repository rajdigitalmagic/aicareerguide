---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const roadmaps = await getCollection('roadmaps', ({ data }) => !data.draft);
  return roadmaps.map(roadmap => ({ params: { slug: roadmap.slug }, props: { roadmap } }));
}
const { roadmap } = Astro.props;
const { Content } = await roadmap.render();
const breadcrumbs = [{ label: 'Home', url: '/' }, { label: 'Careers', url: '/careers' }, { label: roadmap.data.title, url: `/careers/${roadmap.slug}` }];
---
<BaseLayout title={`${roadmap.data.title} | AI Career Guide`} description={roadmap.data.description} image={roadmap.data.image} breadcrumbs={breadcrumbs}>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={breadcrumbs} />
    <header class="mt-5 border-b border-[var(--color-border)] pb-8">
      <div class="flex flex-wrap gap-2"><span class="pill">{roadmap.data.category}</span><span class="pill">{roadmap.data.difficulty}</span><span class="pill">{roadmap.data.estimatedTime}</span></div>
      <h1 class="mt-5 text-4xl sm:text-5xl font-bold tracking-tight">{roadmap.data.title}</h1>
      <p class="mt-4 max-w-3xl text-xl leading-8 text-[var(--color-text-secondary)]">{roadmap.data.description}</p>
      {roadmap.data.skills.length > 0 && <div class="mt-5 flex flex-wrap gap-2">{roadmap.data.skills.map(skill => <span class="tag">{skill}</span>)}</div>}
    </header>
    <div class="mt-10 prose prose-lg max-w-article text-[var(--color-text-secondary)] prose-headings:text-[var(--color-text-primary)] prose-headings:font-bold prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline prose-strong:text-[var(--color-text-primary)]"><Content /></div>
  </article>
</BaseLayout>
