---
// src/pages/careers/[...slug].astro
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const roadmaps = await getCollection('roadmaps');
  return roadmaps.map(roadmap => ({
    params: { slug: roadmap.slug },
    props: { roadmap },
  }));
}

const { roadmap } = Astro.props;
const { Content } = await roadmap.render();
---

<BaseLayout 
  title={`${roadmap.data.title} | AI Career Guide`} 
  description={roadmap.data.description}
  image={roadmap.data.image}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header Section -->
    <header class="mb-10 border-b border-[var(--color-border)] pb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent)] bg-[var(--color-bg-secondary)] px-3 py-1 rounded-md border border-[var(--color-border)]">
          {roadmap.data.category}
        </span>
        <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] bg-[var(--color-bg-secondary)] px-3 py-1 rounded-md border border-[var(--color-border)]">
          {roadmap.data.difficulty}
        </span>
        <span class="text-sm text-[var(--color-text-muted)] flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          {roadmap.data.estimatedTime}
        </span>
      </div>
      
      <h1 class="text-4xl sm:text-5xl font-bold text-[var(--color-text-primary)] leading-tight">
        {roadmap.data.title}
      </h1>
      <p class="mt-4 text-xl text-[var(--color-text-secondary)]">
        {roadmap.data.description}
      </p>
    </header>

    <!-- Markdown Content Wrapper -->
    <div class="prose prose-lg max-w-none text-[var(--color-text-secondary)]
      prose-headings:text-[var(--color-text-primary)] prose-headings:font-bold
      prose-h2:border-b prose-h2:border-[var(--color-border)] prose-h2:pb-2 prose-h2:mt-12
      prose-p:leading-relaxed
      prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
      prose-strong:text-[var(--color-text-primary)]
      prose-ul:text-[var(--color-text-secondary)] prose-ol:text-[var(--color-text-secondary)] marker:text-[var(--color-text-muted)]">
      <Content />
    </div>
  </div>
</BaseLayout>
