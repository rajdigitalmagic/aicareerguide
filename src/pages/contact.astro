---
import BaseLayout from '@/components/layout/BaseLayout.astro';
---

<BaseLayout title="Contact AI Career Guide" description="Get in touch with the AI Career Guide team.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-bold text-[var(--color-text-primary)]">Contact Us</h1>
    
    <div class="mt-8 prose prose-lg max-w-none text-[var(--color-text-secondary)]">
      <p>
        We’d love to hear from you. Whether you have a question, a suggestion, a partnership proposal, or just want to say hello – feel free to reach out.
      </p>
    </div>

    <div class="mt-8 border border-[var(--color-border)] rounded-2xl p-8 bg-[var(--color-bg-secondary)]">
      <form action="#" method="POST" class="space-y-6">
        <div>
          <label for="name" class="block text-sm font-medium text-[var(--color-text-primary)]">Your Name</label>
          <input type="text" id="name" name="name" required class="mt-1 w-full px-4 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition-colors" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-[var(--color-text-primary)]">Email Address</label>
          <input type="email" id="email" name="email" required class="mt-1 w-full px-4 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition-colors" />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-[var(--color-text-primary)]">Message</label>
          <textarea id="message" name="message" rows="6" required class="mt-1 w-full px-4 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition-colors"></textarea>
        </div>
        <button type="submit" class="px-6 py-3 bg-[var(--color-accent)] text-white rounded-lg font-semibold hover:bg-[var(--color-accent-hover)] transition-colors">
          Send Message
        </button>
      </form>
      <p class="mt-4 text-xs text-[var(--color-text-muted)]">
        <em>Note: This is a static placeholder – we’ll connect a backend or email service later.</em>
      </p>
    </div>
  </div>
</BaseLayout>
