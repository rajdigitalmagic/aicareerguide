---
import BaseLayout from '@/components/layout/BaseLayout.astro';
---
<BaseLayout title="Contact AI Career Guide" description="Contact AI Career Guide with questions, suggestions, or collaboration ideas.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <h1 class="text-4xl font-bold tracking-tight">Contact</h1>
    <p class="mt-4 text-lg text-[var(--color-text-secondary)]">Questions, corrections, suggestions, or collaboration ideas are welcome.</p>
    <div class="mt-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)] p-6">
      <form id="contact-form" class="space-y-5">
        <div><label for="name" class="block text-sm font-semibold">Your name</label><input id="name" name="name" required autocomplete="name" class="mt-2 min-h-11 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-4" /></div>
        <div><label for="email" class="block text-sm font-semibold">Email address</label><input id="email" name="email" type="email" required autocomplete="email" class="mt-2 min-h-11 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-4" /></div>
        <div><label for="message" class="block text-sm font-semibold">Message</label><textarea id="message" name="message" rows="7" required class="mt-2 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3"></textarea></div>
        <button type="submit" class="button-primary">Prepare message</button>
      </form>
      <p id="contact-status" class="mt-4 text-sm text-[var(--color-text-muted)]">This static site does not submit messages yet. A form provider can be connected later.</p>
    </div>
  </div>
  <script>
    document.addEventListener('astro:page-load',()=>{const form=document.getElementById('contact-form') as HTMLFormElement|null;const status=document.getElementById('contact-status');form?.addEventListener('submit',e=>{e.preventDefault();if(status)status.textContent='Thanks. The form is ready, but message delivery is not connected yet. Add a form provider before production.';});});
  </script>
</BaseLayout>
