---
const featuredArticles = [
  {
    category: 'CAREER',
    title: 'AI Engineer Roadmap 2026',
    description:
      'A practical roadmap covering the skills, projects and knowledge required to become an AI Engineer.',
    href: '/blog/ai-engineer-roadmap-2026'
  },
  {
    category: 'AI',
    title: 'How to Learn Machine Learning',
    description:
      'A structured approach to learning machine learning without getting lost in endless courses.',
    href: '/blog/how-to-learn-machine-learning'
  },
  {
    category: 'PROJECTS',
    title: 'AI Projects That Build Your Portfolio',
    description:
      'Practical AI projects designed to demonstrate real engineering ability.',
    href: '/projects'
  }
];

const roadmaps = [
  {
    title: 'AI Engineer',
    description: 'From programming fundamentals to production AI systems.',
    href: '/careers/ai-engineer'
  },
  {
    title: 'Machine Learning',
    description: 'Build the mathematical and technical foundation for ML.',
    href: '/ai/machine-learning'
  },
  {
    title: 'Generative AI',
    description: 'Learn LLMs, RAG, agents and modern GenAI engineering.',
    href: '/ai/generative-ai'
  },
  {
    title: 'LLM Engineer',
    description: 'Learn how modern LLM applications are designed and deployed.',
    href: '/ai/llms'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="AI Career Guide — practical AI guides, career roadmaps, real projects and useful tools for aspiring AI engineers."
    />
    <meta name="theme-color" content="#ffffff" />

    <title>AI Career Guide — Learn AI, Build Projects & Build Your Career</title>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: #ffffff;
        color: #111111;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid #eaeaea;
      }

      .nav {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
      }

      .logo {
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.04em;
        white-space: nowrap;
      }

      .logo span {
        color: #635bff;
      }

      .links {
        display: flex;
        align-items: center;
        gap: 26px;
        font-size: 14px;
        font-weight: 600;
        color: #555;
      }

      .links a:hover {
        color: #111;
      }

      .search {
        border: 1px solid #ddd;
        background: #fff;
        border-radius: 8px;
        padding: 9px 13px;
        color: #666;
        font-size: 13px;
      }

      .hero {
        padding: 110px 0 90px;
        border-bottom: 1px solid #eee;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border: 1px solid #ddd;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: #635bff;
        background: #fafaff;
      }

      h1 {
        max-width: 850px;
        margin: 22px 0;
        font-size: clamp(48px, 7vw, 82px);
        line-height: 0.98;
        letter-spacing: -0.065em;
      }

      .hero p {
        max-width: 650px;
        color: #666;
        font-size: 19px;
        line-height: 1.7;
      }

      .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 32px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 13px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        border: 1px solid #111;
      }

      .button.primary {
        background: #111;
        color: #fff;
      }

      .button.secondary {
        background: #fff;
        color: #111;
      }

      section {
        padding: 85px 0;
        border-bottom: 1px solid #eee;
      }

      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 32px;
      }

      .section-header h2 {
        margin: 0;
        font-size: 32px;
        letter-spacing: -0.04em;
      }

      .section-header p {
        max-width: 520px;
        margin: 8px 0 0;
        color: #666;
        line-height: 1.6;
      }

      .discovery-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
      }

      .discovery-card {
        min-height: 180px;
        padding: 24px;
        border: 1px solid #e4e4e4;
        border-radius: 12px;
        transition:
          transform 0.2s ease,
          border-color 0.2s ease;
      }

      .discovery-card:hover {
        transform: translateY(-3px);
        border-color: #aaa;
      }

      .discovery-card h3 {
        margin: 50px 0 8px;
        font-size: 20px;
      }

      .discovery-card p {
        margin: 0;
        color: #666;
        font-size: 14px;
        line-height: 1.6;
      }

      .article-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .article-card {
        border: 1px solid #e4e4e4;
        border-radius: 12px;
        padding: 25px;
        transition:
          transform 0.2s ease,
          border-color 0.2s ease;
      }

      .article-card:hover {
        transform: translateY(-3px);
        border-color: #aaa;
      }

      .category {
        color: #635bff;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.1em;
      }

      .article-card h3 {
        margin: 14px 0 10px;
        font-size: 21px;
        line-height: 1.2;
      }

      .article-card p {
        color: #666;
        line-height: 1.6;
        font-size: 14px;
      }

      .read {
        display: inline-block;
        margin-top: 12px;
        font-size: 13px;
        font-weight: 700;
      }

      .roadmap-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
      }

      .roadmap {
        padding: 25px;
        border: 1px solid #e4e4e4;
        border-radius: 12px;
      }

      .roadmap h3 {
        margin: 0 0 10px;
        font-size: 19px;
      }

      .roadmap p {
        color: #666;
        line-height: 1.6;
        font-size: 14px;
      }

      .newsletter {
        background: #f7f7f7;
        border-radius: 16px;
        padding: 55px;
        display: flex;
        justify-content: space-between;
        gap: 40px;
        align-items: center;
      }

      .newsletter h2 {
        margin: 0 0 10px;
        font-size: 32px;
        letter-spacing: -0.04em;
      }

      .newsletter p {
        margin: 0;
        color: #666;
      }

      .newsletter-form {
        display: flex;
        width: min(440px, 100%);
      }

      .newsletter-form input {
        flex: 1;
        min-width: 0;
        border: 1px solid #ccc;
        border-right: 0;
        padding: 13px;
        border-radius: 8px 0 0 8px;
        font: inherit;
      }

      .newsletter-form button {
        border: 1px solid #111;
        background: #111;
        color: white;
        padding: 0 18px;
        border-radius: 0 8px 8px 0;
        font-weight: 700;
      }

      footer {
        padding: 55px 0;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr repeat(3, 1fr);
        gap: 40px;
      }

      footer h3 {
        margin: 0 0 14px;
        font-size: 14px;
      }

      footer p,
      footer a {
        color: #666;
        font-size: 14px;
        line-height: 2;
      }

      .copyright {
        margin-top: 50px;
        padding-top: 25px;
        border-top: 1px solid #eee;
        color: #888;
        font-size: 13px;
      }

      @media (max-width: 900px) {
        .links {
          display: none;
        }

        .discovery-grid,
        .roadmap-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .article-grid {
          grid-template-columns: 1fr;
        }

        .newsletter {
          flex-direction: column;
          align-items: flex-start;
          padding: 35px;
        }
      }

      @media (max-width: 600px) {
        .container {
          width: min(100% - 28px, 1180px);
        }

        .hero {
          padding: 75px 0 65px;
        }

        h1 {
          font-size: 52px;
        }

        .hero p {
          font-size: 17px;
        }

        section {
          padding: 60px 0;
        }

        .discovery-grid,
        .roadmap-grid {
          grid-template-columns: 1fr;
        }

        .newsletter-form {
          flex-direction: column;
          gap: 8px;
        }

        .newsletter-form input,
        .newsletter-form button {
          border: 1px solid #ccc;
          border-radius: 8px;
          min-height: 46px;
        }

        .newsletter-form button {
          background: #111;
          border-color: #111;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container nav">
        <a href="/" class="logo">AI Career <span>Guide</span></a>

        <nav class="links" aria-label="Main navigation">
          <a href="/ai">AI</a>
          <a href="/careers">Careers</a>
          <a href="/projects">Projects</a>
          <a href="/tools">Tools</a>
          <a href="/resources">Resources</a>
          <a href="/blog">Blog</a>
        </nav>

        <a class="search" href="/blog">Search</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <span class="eyebrow">AI CAREER GUIDE</span>

          <h1>Build Your Career in the Age of AI.</h1>

          <p>
            Practical guides, real projects, useful tools, and career
            resources for the next generation of AI engineers.
          </p>

          <div class="buttons">
            <a class="button primary" href="/ai">Explore AI Guides →</a>
            <a class="button secondary" href="/projects">Explore Projects</a>
          </div>
        </div>
      </section>

      <section>
        <div class="container">
          <div class="section-header">
            <div>
              <h2>What are you looking for?</h2>
              <p>
                Choose a path based on what you want to accomplish.
              </p>
            </div>
          </div>

          <div class="discovery-grid">
            <a href="/ai" class="discovery-card">
              <span class="category">01</span>
              <h3>Learn AI</h3>
              <p>Roadmaps, tutorials and practical AI concepts.</p>
            </a>

            <a href="/projects" class="discovery-card">
              <span class="category">02</span>
              <h3>Build</h3>
              <p>Real projects that strengthen your portfolio.</p>
            </a>

            <a href="/careers" class="discovery-card">
              <span class="category">03</span>
              <h3>Get Hired</h3>
              <p>Career guides, internships and interview preparation.</p>
            </a>

            <a href="/tools" class="discovery-card">
              <span class="category">04</span>
              <h3>Use AI</h3>
              <p>Useful AI tools for students and developers.</p>
            </a>
          </div>
        </div>
      </section>

      <section>
        <div class="container">
          <div class="section-header">
            <div>
              <h2>Featured Guides</h2>
              <p>
                Start with practical guides designed to move you forward.
              </p>
            </div>

            <a href="/blog" class="read">View all →</a>
          </div>

          <div class="article-grid">
            {featuredArticles.map((article) => (
              <a href={article.href} class="article-card">
                <span class="category">{article.category}</span>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <span class="read">Read guide →</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section>
        <div class="container">
          <div class="section-header">
            <div>
              <h2>Popular AI Roadmaps</h2>
              <p>
                Structured learning paths without the endless course
                collecting.
              </p>
            </div>
          </div>

          <div class="roadmap-grid">
            {roadmaps.map((roadmap) => (
              <a href={roadmap.href} class="roadmap">
                <h3>{roadmap.title} →</h3>
                <p>{roadmap.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section>
        <div class="container">
          <div class="section-header">
            <div>
              <h2>Build Real AI Projects</h2>
              <p>
                Learn by building systems that demonstrate actual engineering
                ability.
              </p>
            </div>

            <a href="/projects" class="read">Explore projects →</a>
          </div>

          <div class="article-grid">
            <a href="/projects" class="article-card">
              <span class="category">INTERMEDIATE</span>
              <h3>AI Resume Analyzer</h3>
              <p>
                Build an application that analyzes resumes and provides
                structured career feedback.
              </p>
              <span class="read">View project →</span>
            </a>

            <a href="/projects" class="article-card">
              <span class="category">INTERMEDIATE</span>
              <h3>RAG Knowledge Assistant</h3>
              <p>
                Build a document question-answering system using retrieval
                augmented generation.
              </p>
              <span class="read">View project →</span>
            </a>

            <a href="/projects" class="article-card">
              <span class="category">ADVANCED</span>
              <h3>AI Career Recommendation Engine</h3>
              <p>
                Design a system that recommends career paths based on skills
                and goals.
              </p>
              <span class="read">View project →</span>
            </a>
          </div>
        </div>
      </section>

      <section>
        <div class="container">
          <div class="newsletter">
            <div>
              <h2>AI Career Weekly</h2>
              <p>
                One useful AI concept, project, tool, and career insight every
                week.
              </p>
            </div>

            <form class="newsletter-form">
              <input
                type="email"
                placeholder="Your email"
                aria-label="Your email"
                required
              />
              <button type="submit">Subscribe</button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <div class="footer-grid">
          <div>
            <a href="/" class="logo">AI Career <span>Guide</span></a>
            <p>
              Learn AI. Build Real Projects. Build Your Career.
            </p>
          </div>

          <div>
            <h3>Explore</h3>
            <a href="/ai">AI</a><br />
            <a href="/careers">Careers</a><br />
            <a href="/projects">Projects</a><br />
            <a href="/tools">Tools</a>
          </div>

          <div>
            <h3>Resources</h3>
            <a href="/resources">Resources</a><br />
            <a href="/blog">Blog</a><br />
            <a href="/about">About</a>
          </div>

          <div>
            <h3>Legal</h3>
            <a href="/privacy">Privacy</a><br />
            <a href="/terms">Terms</a><br />
            <a href="/contact">Contact</a>
          </div>
        </div>

        <div class="copyright">
          © 2026 AI Career Guide. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
