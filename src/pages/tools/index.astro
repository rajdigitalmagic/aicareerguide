---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
const tools = await getCollection('tools', ({ data }) => !data.draft);
const categories = ['All', 'AI', 'Developer', 'Career', 'Research', 'Productivity', 'Design'];
---
<BaseLayout title="AI & Developer Tools" description="A curated directory of useful AI, developer, career, research, productivity, and design tools.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent)]">Tools</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Useful Tools</h1>
    <p class="mt-3 max-w-2xl text-lg text-[var(--color-text-secondary)]">A focused directory of tools that can improve learning, building, research, and career workflows.</p>
    <div class="mt-8 flex flex-wrap gap-2">{categories.map(category => <button type="button" aria-pressed="false" class="tool-filter rounded-full border border-[var(--color-border)] px-4 py-2 text-sm" data-category={category}>{category}</button>)}</div>
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{tools.map(tool => <article class="tool-card rounded-2xl border border-[var(--color-border)] p-6" data-category={tool.data.category}><div class="flex justify-between gap-3"><span class="text-xs font-bold uppercase tracking-wider text-[var(--color-accent)]">{tool.data.category}</span><span class="text-xs text-[var(--color-text-muted)]">{tool.data.pricing}</span></div><h2 class="mt-3 text-xl font-bold">{tool.data.name}</h2><p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">{tool.data.description}</p><div class="mt-4 flex flex-wrap gap-2">{tool.data.tags.map(tag => <span class="tag">{tag}</span>)}</div><a href={tool.data.url} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block font-semibold text-[var(--color-accent)] hover:underline">Visit tool →</a></article>)}</div>
  </div>
  <script>
    document.addEventListener('astro:page-load', () => { const buttons=document.querySelectorAll<HTMLButtonElement>('.tool-filter'); const cards=document.querySelectorAll<HTMLElement>('.tool-card'); const apply=(category='All')=>{buttons.forEach(b=>{const active=b.dataset.category===category;b.classList.toggle('active-filter',active);b.setAttribute('aria-pressed',String(active));});cards.forEach(c=>c.classList.toggle('hidden',category!=='All'&&c.dataset.category!==category));};buttons.forEach(b=>b.addEventListener('click',()=>apply(b.dataset.category||'All')));apply(); });
  </script>
</BaseLayout>
